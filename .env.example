# ======== 舆情分析系统 配置模板 ========
# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 含密钥，不要提交到 git

# ---------- SearXNG ----------
# 优先 HTTPS 公网，不通则换内网
SEARXNG_URL=https://searxng.6556888.xyz
# SEARXNG_URL=http://192.168.68.112:8889
SEARXNG_TIMEOUT=25
# 使用 docker-compose.searxng.yml 时可固定镜像版本；留空/删除则使用 latest
SEARXNG_VERSION=latest

# ---------- 分析搜索服务（均由后端调用，Key 不会回传前端） ----------
# 调用顺序固定为 SearXNG → Brave → Tavily；未配置/不可用的服务自动跳过
SEARCH_PROVIDER_ORDER=searxng,brave,tavily
SEARCH_PROVIDER_MODE=failover
SEARCH_TIMEOUT=25
BRAVE_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_LANG=zh-hans
BRAVE_COUNTRY=CN
TAVILY_API_KEY=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
# basic/fast/ultra-fast=1 credit；advanced=2 credits
TAVILY_SEARCH_DEPTH=basic

# ---------- AI 网关（OpenAI 兼容，按优先级回退） ----------
# 1. 本地 9router（OpenAI 兼容网关，部署在局域网/本机；base_url 需填写真实地址，示例不可用）
AI_ROUTER_BASE_URL=http://127.0.0.1:3000/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=

# 2. DeepSeek 官方（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 3. 通义千问（DashScope 兼容端点，enable_search=true 时模型自带搜索，可作补充信源）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENABLE_SEARCH=false

# 主模型选择：deepseek | qwen | router（不填则自动挑选有 key 的）
AI_PRIMARY_PROVIDER=

# ---------- 其他 ----------
HTTP_TIMEOUT=25
MAX_ITEMS_PER_QUERY=30

# ---------- 安全与部署 ----------
# 推荐通过部署环境注入；至少 6 个字符，建议使用更长的随机值；留空时首次启动会在 data/admin_token 生成令牌并写入启动日志
MIAOYU_ADMIN_TOKEN=
# 默认不允许跨域；如必须由固定前端域名调用，填写完整 Origin，例如 https://yuqing.example.com
MIAOYU_ALLOWED_ORIGIN=
# 单次请求体上限（MB），报告编辑/图表导出需要一定空间
MIAOYU_MAX_BODY_MB=10
# 仅当应用位于一层受信反向代理（如 Cloudflare Tunnel/Nginx）后时设为 1
MIAOYU_TRUST_PROXY=0
# Cloudflare Tunnel 远程管理隧道令牌（仅在使用 docker-compose.cloudflare.yml 时填写）
CLOUDFLARE_TUNNEL_TOKEN=

# ===== 热榜官方 API（榜眼数据 tophubdata，每日免费 1000 次）=====
# 当前 key 返回"余额不足"：控制台开通/充值后填写即可自动启用；留空 = 始终用 HTML 兜底
TOPHUBDATA_KEY=
# 每日配额阈值（达到后自动切 HTML 兜底，留默认）
HOT_DAILY_LIMIT=900
