# ======== 舆情分析系统 配置模板 ========
# 复制为 .env 后填写真实值：cp .env.example .env
# 注意：.env 含密钥，不要提交到 git

# ---------- SearXNG ----------
# 优先 HTTPS 公网，不通则换内网
SEARXNG_URL=https://searxng.6556888.xyz
# SEARXNG_URL=http://192.168.68.112:8889
SEARXNG_TIMEOUT=25

# ---------- AI 网关（OpenAI 兼容，按优先级回退） ----------
# 1. 本地 9router（OpenAI 兼容网关，部署在局域网/本机；base_url 需填写真实地址，示例不可用）
AI_ROUTER_BASE_URL=http://127.0.0.1:3000/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=

# 2. DeepSeek 官方（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 3. 通义千问（DashScope 兼容端点，enable_search=true 时模型自带搜索，可作补充信源）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENABLE_SEARCH=false

# 主模型选择：deepseek | qwen | router（不填则自动挑选有 key 的）
AI_PRIMARY_PROVIDER=

# ---------- 其他 ----------
HTTP_TIMEOUT=25
MAX_ITEMS_PER_QUERY=30